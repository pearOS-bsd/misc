#!/bin/sh
# open [-a APP] [-n] [-g] [--args ...] APP.app | FILE ...: the `open` of the Mac.  A .app is started (a Mac application: on the AppKit of the "open" layer, the real dyld of the Mac under darwinator,
# our AppKit, the windows on wsd; the bundle is patched once into ~/Library/Caches/open and everything else is linked to the original); a file or folder goes to the application named with -a, else to
# the default one (text: TextEdit), else to xdg-open.   open Notes.app     open -a TextEdit note.txt     open note.txt
PY=/usr/local/bin/python3
APPNAME=""; ARGS=""
while [ $# -gt 0 ]; do
	case "$1" in
	-a) APPNAME="$2"; shift 2 ;;
	-n|-g|-j|-F|-W|-R) shift ;;
	--args) shift; break ;;
	-b) echo "open: -b (bundle identifiers) is not supported" >&2; exit 64 ;;
	-*) echo "open: unknown option $1" >&2; exit 64 ;;
	*) break ;;
	esac
done
find_app() {		# a name or a path -> the .app
	case "$1" in /*.app|./*.app|*/*.app) [ -d "$1" ] && { echo "$1"; return 0; } ;; esac
	n="${1%.app}"
	for d in /System/Applications /System/Applications/Utilities /Applications /Applications/Utilities "$HOME/Applications" "$(pwd)"; do [ -d "$d/$n.app" ] && { echo "$d/$n.app"; return 0; }; done
	return 1
}
run_app() {		# APP.app [FILE ...]
	APP="$(cd "$1" && pwd)"; shift
	EXE="$($PY -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1]+"/Contents/Info.plist","rb"))["CFBundleExecutable"])' "$APP" 2>/dev/null)"
	[ -n "$EXE" ] || { echo "open: $APP is not an application" >&2; exit 1; }
	CACHE="${XDG_CACHE_HOME:-$HOME/Library/Caches}/open/$(basename "$APP")"; STAMP="$CACHE/.patched"
	if [ ! -f "$STAMP" ] || [ "$APP/Contents/MacOS/$EXE" -nt "$STAMP" ] || [ /open/AppKit -nt "$STAMP" ]; then
		rm -rf "$CACHE"; mkdir -p "$CACHE" || exit 1
		$PY /usr/local/libexec/open-patch.py --bundle "$APP" "$CACHE" >&2 || exit 1
		touch "$STAMP"
	fi
	export WS_SOCKET="${WS_SOCKET:-/tmp/wsd.sock}"
	exec "$CACHE/Contents/MacOS/$EXE" "$@"
}
abs() { for f in "$@"; do echo "$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"; done; }
[ $# -gt 0 ] || [ -n "$APPNAME" ] || { echo "usage: open [-a APP] [--args ...] APP.app | FILE ..." >&2; exit 64; }
if [ -n "$APPNAME" ]; then app="$(find_app "$APPNAME")" || { echo "open: application $APPNAME not found" >&2; exit 1; }; run_app "$app" $(abs "$@")
fi
case "$1" in
*.app|*.app/) app="$(find_app "${1%/}")" || { echo "open: $1 not found" >&2; exit 1; }; shift; run_app "$app" "$@" ;;
esac
for f in "$@"; do
	[ -e "$f" ] || { echo "open: $f: no such file" >&2; exit 1; }
	case "$(echo "$f" | tr A-Z a-z)" in
	*.txt|*.md|*.markdown|*.rtf|*.log|*.json|*.xml|*.csv|*.sh|*.c|*.h|*.m|*.py|*.js|*.css|*.html) if app="$(find_app TextEdit)"; then run_app "$app" "$(abs "$f")"; fi ;;
	esac
	exec xdg-open "$f"
done
