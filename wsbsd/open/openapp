#!/bin/sh
# openapp APP.app [FILE]: runs a Mac application (a .app with a Mach-O executable) on the AppKit of the "open" layer in the desktop session (the real dyld of the Mac under darwinator, our AppKit,
# the windows on wsd).  The bundle is patched once into the user's cache (the Mach-O files: AppKit/Cocoa -> /open), everything else is linked to the original.
APP="$1"; [ -d "$APP" ] || { echo "usage: openapp APP.app [FILE]" >&2; exit 64; }; shift
APP="$(cd "$APP" && pwd)"
EXE="$(/usr/local/bin/python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1]+"/Contents/Info.plist","rb"))["CFBundleExecutable"])' "$APP" 2>/dev/null)"
[ -n "$EXE" ] || { echo "openapp: no CFBundleExecutable in $APP" >&2; exit 1; }
CACHE="${XDG_CACHE_HOME:-$HOME/Library/Caches}/open/$(basename "$APP")"
STAMP="$CACHE/.patched"
if [ ! -f "$STAMP" ] || [ "$APP/Contents/MacOS/$EXE" -nt "$STAMP" ] || [ /open/AppKit -nt "$STAMP" ]; then
	rm -rf "$CACHE"; mkdir -p "$CACHE" || exit 1
	/usr/local/bin/python3 /usr/local/libexec/open-patch.py --bundle "$APP" "$CACHE" >&2 || exit 1
	touch "$STAMP"
fi
export WS_SOCKET="${WS_SOCKET:-/tmp/wsd.sock}"
[ $# -gt 0 ] && [ -e "$1" ] && set -- "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
exec "$CACHE/Contents/MacOS/$EXE" "$@"
