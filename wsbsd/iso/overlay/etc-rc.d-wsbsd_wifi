#!/bin/sh
# PROVIDE: wsbsd_wifi
# REQUIRE: FILESYSTEMS kld
# BEFORE: netif
# KEYWORD: nojail
# Brings up every Wi-Fi card the machine has, without the user running ifconfig / wpa_supplicant / dhclient: loads the drivers, creates a wlan interface on each card, starts wpa_supplicant
# on it with a control socket (airportd and the Control Center join networks through that socket) and asks for an address as soon as the interface is associated.
. /etc/rc.subr
name="wsbsd_wifi"
rcvar="wsbsd_wifi_enable"
start_cmd="wsbsd_wifi_start"
stop_cmd=":"
wsbsd_wifi_start()
{
	kldload -n wlan wlan_wep wlan_ccmp wlan_tkip wlan_amrr >/dev/null 2>&1
	# every Wi-Fi driver FreeBSD 14 has (PCI: Intel, Realtek, Atheros, Broadcom, Ralink, Marvell; USB: Realtek, Ralink, Atheros, Zydas, Marvell); the ones without the card just do not attach
	for m in if_iwlwifi if_iwm if_iwn if_iwx if_iwi if_ipw if_wpi if_rtw88 if_rtw89 if_rtwn if_rtwn_pci if_rtwn_usb if_rtwn_sdio if_rtw if_rsu if_urtw if_urtwn if_ath if_ath_pci if_ath_usb if_otus if_uath if_athp if_ath10k if_ath11k if_mt76 if_mt7921 if_bwn_pci if_bwn if_bwi if_ral if_rum if_run if_zyd if_upgt if_malo if_mwl if_mwifiex if_brcmfmac if_qtnfmac if_rtl8821cu; do kldload -n $m >/dev/null 2>&1; done
	# the medium (and so /etc) is read-only: the configuration lives in memory, update_config=1 lets the Control Center save the networks it joins there
	CONF=/var/run/wsbsd_wpa_supplicant.conf
	[ -f $CONF ] || printf 'ctrl_interface=/var/run/wpa_supplicant\nctrl_interface_group=wheel\nupdate_config=1\neapol_version=2\nap_scan=1\ncountry=RO\n' > $CONF
	ln -sf $CONF /var/run/wpa_supplicant.conf 2>/dev/null
	mkdir -p /var/run/wpa_supplicant
	# cards that attach late (USB dongles, drivers devmatch loads after boot) are picked up for the first minute
	( t=0
	  while [ $t -lt 20 ]; do
		sleep 3; t=$((t + 1))
		for parent in $(sysctl -n net.wlan.devices 2>/dev/null); do
			for w in $(ifconfig -l | tr ' ' '\n' | grep '^wlan'); do ifconfig $w 2>/dev/null | grep -q "parent interface: $parent" && continue 2; done
			n=0; while ifconfig wlan$n >/dev/null 2>&1; do n=$((n + 1)); done; ifn=wlan$n
			ifconfig $ifn create wlandev $parent >/dev/null 2>&1 || continue
			ifconfig $ifn up >/dev/null 2>&1
			pgrep -qf "wpa_supplicant.*-i $ifn" || wpa_supplicant -B -s -i $ifn -c $CONF -f /var/log/wpa_supplicant.log >/dev/null 2>&1
			( until ifconfig $ifn 2>/dev/null | grep -q "status: associated"; do sleep 2; done; dhclient $ifn >/dev/null 2>&1 ) &
		done
	  done ) &
	# what the Wi-Fi did, as a file on the desktop ("Wi-Fi report.txt"): cards, interfaces, wpa_supplicant, scan, address
	( sleep 45; R=/var/log/wsbsd_wifi.log
	  { echo "== Wi-Fi report $(date '+%H:%M:%S')"; echo "-- net.wlan.devices: $(sysctl -n net.wlan.devices 2>&1)"
	    echo "-- interfaces"; ifconfig -a | grep -E '^[a-z]|ether|inet |status|ssid|parent' 
	    echo "-- wpa_supplicant"; pgrep -lf wpa_supplicant; for w in $(ifconfig -l | tr ' ' '\n' | grep '^wlan'); do echo "wlan: $w"; wpa_cli -p /var/run/wpa_supplicant -i $w status 2>&1 | head -8; echo "scan results:"; wpa_cli -p /var/run/wpa_supplicant -i $w scan_results 2>&1 | head -12; done
	    echo "-- wpa_supplicant.log"; tail -25 /var/log/wpa_supplicant.log 2>&1
	    echo "-- kernel (wlan / iwlwifi / firmware)"; dmesg | grep -i -E 'wlan|iwlwifi|iwm|rtw|firmware|80211' | tail -25
	    echo "-- loaded wifi modules"; kldstat | grep -i -E 'wlan|iwl|iwm|rtw|ath|if_'; } > $R 2>&1 ) &
}
load_rc_config $name
run_rc_command "$1"
