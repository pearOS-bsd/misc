#!/bin/sh
# PROVIDE: wsbsd_gpu
# REQUIRE: FILESYSTEMS kld wsbsd_overlay
# BEFORE: LOGIN macdesktop
# KEYWORD: nojail
# Loads the native graphics driver of the machine's GPU (drm-kmod: i915kms for Intel, amdgpu / radeonkms for AMD, with their firmware) before the window server starts. The console framebuffer
# the window server draws on then comes from the driver (fbdev emulation): native resolution of the panel and of external displays instead of the EFI mode. NVIDIA has no driver here and keeps
# the EFI framebuffer, like virtual GPUs (QEMU, VMware, VirtualBox, virtio) and the CI. Safety: the EFI partition (label EFISYS) holding a file `nogpu` skips this script, a driver that does
# not load within 40 seconds is given up on.
. /etc/rc.subr
name="wsbsd_gpu"
rcvar="wsbsd_gpu_enable"
start_cmd="wsbsd_gpu_start"
stop_cmd=":"
LOG=/var/log/wsbsd_gpu.log
wsbsd_gpu_log() { echo "$*" >> $LOG; }
wsbsd_gpu_try()
{
	# a module counts only when it took the card: kldload succeeds for a driver that attaches to nothing (amdgpu on a Radeon of the CIK / Kaveri generation, radeonkms on a recent one), so /dev/dri/card0 must appear
	for m in "$@"; do
		if [ ! -e /boot/modules/$m.ko ]; then wsbsd_gpu_log "module $m: not installed (/boot/modules/$m.ko missing)"; continue; fi
		wsbsd_gpu_log "module $m: installed"
		if kldstat -q -n $m 2>/dev/null; then wsbsd_gpu_log "module $m: already loaded"; fi
		timeout 40 kldload -n $m >/dev/null 2>&1; rc=$?
		if [ $rc != 0 ]; then wsbsd_gpu_log "module $m: kldload failed (exit $rc$([ $rc = 124 ] && echo ', timed out after 40 s'))"; continue; fi
		wsbsd_gpu_log "module $m: loaded"
		i=0; while [ $i -lt 20 ] && [ ! -e /dev/dri/card0 ]; do sleep 0.25; i=$((i + 1)); done
		if [ -e /dev/dri/card0 ]; then
			wsbsd_gpu_log "module $m: attached, /dev/dri/card0 present"
			echo "wsbsd_gpu: $m loaded" > /dev/console 2>/dev/null; return 0
		fi
		wsbsd_gpu_log "module $m: loaded but attached to no card (no /dev/dri/card0 within 5 s), unloading"
		kldunload $m >/dev/null 2>&1
	done
	return 1
}
# a GL probe before the window server starts: the OpenGL ES compositor is started once on the render node in a throw-away headless wsd, with the driver's debug output on and every system call traced; what
# failed (system calls, kernel messages, Mesa / EGL messages) goes into the report, so that a machine where EGL does not start explains itself without anyone typing commands
wsbsd_gpu_probe()
{
	[ -x /usr/local/sbin/wsd ] || return 0
	P=/var/log/wsbsd_gl_probe; T=/var/run/wsbsd_gl_probe.truss; rm -f $T
	wsbsd_gpu_log "-- GL probe (headless wsd, GL compositor on /dev/dri/renderD128, drm debug core+driver, 8 s)"
	wsbsd_gpu_log "i915 parameters: $(sysctl -n compat.linuxkpi.i915_enable_guc 2>/dev/null | sed 's/^/enable_guc=/') $(sysctl -n compat.linuxkpi.i915_reset 2>/dev/null | sed 's/^/reset=/') $(sysctl -n compat.linuxkpi.i915_modeset 2>/dev/null | sed 's/^/modeset=/')"
	before=$(dmesg | wc -l)
	sysctl compat.linuxkpi.drm_debug=0x03 >/dev/null 2>&1
	WS_SOCKET=/var/run/wsbsd_gl_probe.sock LIBGL_DEBUG=verbose MESA_DEBUG=1 EGL_LOG_LEVEL=debug timeout 8 truss -f -o $T /usr/local/sbin/wsd -b headless -r gl -g 640x480 > $P.out 2>&1
	sysctl compat.linuxkpi.drm_debug=0 >/dev/null 2>&1
	rm -f /var/run/wsbsd_gl_probe.sock
	# the same start with each Mesa driver forced in turn (what works tells where the fault is: iris = the Intel driver, zink = Vulkan on top, kms_swrast / swrast = software rendering through the same GBM / EGL path)
	{ echo "-- Mesa drivers one by one (wsd: GL init / GL compositor lines)"
	  for d in iris zink kms_swrast swrast; do
	    echo "== MESA_LOADER_DRIVER_OVERRIDE=$d"
	    WS_SOCKET=/var/run/wsbsd_gl_probe.sock MESA_LOADER_DRIVER_OVERRIDE=$d MESA_DEBUG=1 EGL_LOG_LEVEL=debug timeout 6 /usr/local/sbin/wsd -b headless -r gl -g 640x480 2>&1 | grep -E 'wsd: (GL|render)|libEGL|MESA|iris|zink|error|failed' | head -6
	    rm -f /var/run/wsbsd_gl_probe.sock
	  done
	  echo "-- the last 60 system calls of the first probe (what Mesa did before it gave up)"
	  tail -60 $T | cut -c1-200
	} > $P.drivers 2>&1
	# what the i915 driver answers to the questions Mesa asks first (slices, EUs, engines, a context): tells a GPU that is not set up from one that Mesa cannot use
	{ echo "-- gbmprobe (render node)"; [ -x /usr/local/bin/gbmprobe ] && LIBGL_DEBUG=verbose MESA_DEBUG=1 EGL_LOG_LEVEL=debug truss -f -o $P.gbm.truss /usr/local/bin/gbmprobe /dev/dri/renderD128 2>&1 || echo "(gbmprobe missing)"
	  echo "-- gbmprobe with swrast"; [ -x /usr/local/bin/gbmprobe ] && MESA_LOADER_DRIVER_OVERRIDE=swrast LIBGL_DEBUG=verbose /usr/local/bin/gbmprobe /dev/dri/renderD128 2>&1
	  ls -l /usr/local/lib/gbm /usr/local/lib/dri 2>&1 | head -20
	  echo "-- i915probe (render node)"; [ -x /usr/local/bin/i915probe ] && /usr/local/bin/i915probe /dev/dri/renderD128 2>&1 || echo "(i915probe missing)"
	  echo "-- i915probe (card0)"; [ -x /usr/local/bin/i915probe ] && /usr/local/bin/i915probe /dev/dri/card0 2>&1 | head -45
	} > $P.i915probe 2>&1
	{ echo "== GL diagnosis $(date '+%H:%M:%S')"; sed -n '/^-- gbmprobe (render node)/,/^-- i915probe (render node)/p' $P.i915probe | grep -v '^-- i915probe'
	  echo "-- gbmprobe truss: files opened / failed calls"; grep -E 'open\(|ERR#|gbm|dlopen' $P.gbm.truss | grep -E 'dri|gbm|gallium|mesa|EGL|ERR#' | grep -v -E 'drirc|ioctl' | cut -c1-170 | head -45
	  echo "-- failed ioctls of gbmprobe"; grep -E 'ioctl\(.*ERR#' $P.gbm.truss | cut -c1-170 | head -15
	  echo "-- last 25 calls of gbmprobe"; tail -25 $P.gbm.truss | cut -c1-170; } > /var/log/wsbsd_gl_diag.txt 2>&1
	{ echo "-- GL probe: what wsd said"; grep -v drirc $P.out | head -20
	  echo "-- GL probe: ioctls on the DRM nodes that failed (ERR#19 = no such device, #22 = invalid argument)"
	  grep -E 'ioctl\(.*ERR#' $T | head -30
	  cat $P.drivers
	  cat $P.i915probe
	  echo "-- GL probe: kernel messages during the probe (drm debug core+driver)"
	  dmesg | tail -n +$((before + 1)) | grep -v -E 'drirc|atomic|power_well|tc_port|vblank' | head -80
	  echo "-- GL probe: end"
	} >> $LOG 2>&1
}
# the long GL probe (about 40 s of boot) runs only when the EFI partition holds a file gpu.debug
# what the kernel and the drivers said about the card (firmware that is missing shows up here)
wsbsd_gpu_dmesg()
{
	wsbsd_gpu_log "-- kernel messages (drm / i915 / amdgpu / radeon / firmware)"
	dmesg 2>/dev/null | grep -i -E 'drm|i915|amdgpu|radeon|\[drm|firmware' | tail -25 >> $LOG
}
wsbsd_gpu_start()
{
	: > $LOG
	wsbsd_gpu_log "== wsbsd GPU report $(date '+%Y-%m-%d %H:%M:%S') $(uname -sr)"
	wsbsd_gpu_log "machine: $(kenv -q smbios.system.maker 2>/dev/null) $(kenv -q smbios.system.product 2>/dev/null)"
	wsbsd_gpu_log "-- detected display controllers (PCI class 03)"
	det="$(pciconf -lv 2>/dev/null | awk '/^[a-z]+[0-9]+@pci/ { if (blk ~ /class=0x03/) print blk; blk = $0; next } /^    / { blk = blk "\n" $0 } END { if (blk ~ /class=0x03/) print blk }')"
	if [ -n "$det" ]; then wsbsd_gpu_log "$det"; else wsbsd_gpu_log "(none found)"; fi
	case "$(kenv -q smbios.system.product 2>/dev/null)" in wsbsd-ci*) wsbsd_gpu_log "result: skipped (CI run), EFI framebuffer, software compositor"; return 0 ;; esac
	M=/var/run/wsbsd_esp_gpu; mkdir -p $M; dbg=
	for dev in /dev/msdosfs/EFISYS $(ls /dev/ada*p1 /dev/da*p1 /dev/nvd*p1 /dev/nda*p1 /dev/mmcsd*p1 /dev/cd* 2>/dev/null); do
		[ -e "$dev" ] || continue
		mount -t msdosfs -o ro "$dev" $M 2>/dev/null || continue
		[ -f $M/gpu.debug ] && dbg=1
		if [ -f $M/nogpu ]; then umount $M 2>/dev/null; wsbsd_gpu_log "result: skipped (file nogpu on the EFI partition), EFI framebuffer, software compositor"; return 0; fi
		umount $M 2>/dev/null
	done
	# display controllers (PCI class 03): vendor 8086 Intel, 1002 AMD; 10de NVIDIA and the virtual GPUs stay on the EFI framebuffer
	gpus="$(pciconf -l 2>/dev/null | grep -E 'class=0x03(00|80)' )"
	if echo "$gpus" | grep -q -E 'vendor=0x8086|chip=0x[0-9a-f]{4}8086'; then
		wsbsd_gpu_log "vendor: Intel -> i915kms"
		if wsbsd_gpu_try i915kms; then wsbsd_gpu_log "result: i915kms drives the GPU (DRM/KMS), the window server uses OpenGL ES if EGL starts"; wsbsd_gpu_dmesg; [ -n "$dbg" ] && wsbsd_gpu_probe; return 0; fi
	fi
	if echo "$gpus" | grep -q -E 'vendor=0x1002|chip=0x[0-9a-f]{4}1002'; then
		wsbsd_gpu_log "vendor: AMD -> radeonkms, then amdgpu"
		if wsbsd_gpu_try radeonkms amdgpu; then wsbsd_gpu_log "result: AMD driver drives the GPU (DRM/KMS), the window server uses OpenGL ES if EGL starts"; wsbsd_gpu_dmesg; [ -n "$dbg" ] && wsbsd_gpu_probe; return 0; fi
	fi
	if echo "$gpus" | grep -q -E 'vendor=0x1af4 device=0x1050'; then
		wsbsd_gpu_log "vendor: virtio GPU (QEMU / KVM) -> virtio_gpu (virgl 3D when the host offers it)"
		# the module is a PCI driver of its own (it brings its own virtio transport): FreeBSD's virtio_pci must let go of the device first
		for vp in $(pciconf -l 2>/dev/null | grep -E 'vendor=0x1af4 device=0x1050' | cut -d@ -f1 | grep '^virtio_pci'); do devctl detach $vp >/dev/null 2>&1; done
		if wsbsd_gpu_try virtio_gpu; then wsbsd_gpu_log "result: virtio_gpu drives the GPU (DRM/KMS), the window server uses OpenGL ES (virgl) if the host has 3D, else the software compositor"; wsbsd_gpu_dmesg; [ -n "$dbg" ] && wsbsd_gpu_probe; return 0; fi
	fi
	echo "$gpus" | grep -q -E 'vendor=0x10de|chip=0x[0-9a-f]{4}10de' && wsbsd_gpu_log "vendor: NVIDIA, no driver on this image"
	[ -n "$gpus" ] || wsbsd_gpu_log "no PCI display controller"
	wsbsd_gpu_log "result: no GPU driver took a card, EFI framebuffer, software compositor (CPU)"
	wsbsd_gpu_dmesg
	return 0
}
load_rc_config $name
run_rc_command "$1"
