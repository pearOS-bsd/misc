#!/bin/sh
# PROVIDE: macdesktop
# REQUIRE: LOGIN devd
# KEYWORD: shutdown
# The desktop: the window server on the console framebuffer, then the login-less session (Terminal). Silent: kernel messages are muted so that nothing is drawn over the screen.
. /etc/rc.subr
name="macdesktop"
rcvar="macdesktop_enable"
start_cmd="macdesktop_start"
stop_cmd="macdesktop_stop"
WS=/System/Library/PrivateFrameworks/SkyLight.framework/Versions/A/Resources/WindowServer
macdesktop_start()
{
	conscontrol mute on >/dev/null 2>&1
	case "$(kenv -q smbios.system.product 2>/dev/null)" in                  # guest tools of the hypervisor this runs in (iso/tools/guesttools.sh put them in the image)
	VMware*) { service vmware-kmod onestart; service vmware-guestd onestart; } >/dev/null 2>&1 || true ;;
	VirtualBox*) { kldload vboxguest; service vboxservice onestart; } >/dev/null 2>&1 || true ;;
	esac
	export WSD_SPLASH=1 WS_SOCKET=/var/run/WindowServer.sock HOME=/Users/root XDG_CURRENT_DESKTOP=Aqua XDG_SESSION_DESKTOP=Aqua XDG_SESSION_TYPE=wsd TERM=xterm-256color
	[ -x /bin/zsh ] && export SHELL=/bin/zsh
	mkdir -p /var/run
	# the image is read-only: the home of the session (preferences, GNUstep's caches and sockets) is memory
	mount | grep -q ' /Users/Shared ' || mount -t tmpfs -o mode=1777 tmpfs /Users/Shared
	mount | grep -q ' /root ' || mount -t tmpfs -o mode=755 tmpfs /root
	# the home of the session is where macOS keeps it: /Users/<name> (a memory file system over the empty directory of the image) with the folders of a new account
	mount | grep -q ' /Users/root ' || mount -t tmpfs -o mode=755 tmpfs /Users/root
	[ -d "/Library/User Template" ] && cp -R "/Library/User Template/." /Users/root/ 2>/dev/null       # the demo content (iso/tools/mkdemo.py)
	mkdir -p /Users/root/Desktop /Users/root/Documents /Users/root/Downloads /Users/root/Library/Preferences /Users/root/Movies /Users/root/Music /Users/root/Pictures /Users/root/Public /Users/root/GNUstep
	mkdir -p /Users/Shared/GNUstep /root/GNUstep /Users/Shared/Downloads /root/Downloads /tmp/GNUstepSecure
	chmod 700 /tmp/GNUstepSecure
	# GNUstep's name server and notification center must be up before the first application: started on demand they time out on slow machines and the application dies ("unable to contact GDNC server")
	GS=/usr/local/GNUstep/System/Tools
	pgrep -x gdomap >/dev/null || daemon -f -p /var/run/gdomap.pid $GS/gdomap -f
	i=0; while [ $i -lt 30 ] && ! pgrep -x gdomap >/dev/null; do sleep 1; i=$((i+1)); done
	pgrep -x gdnc >/dev/null || daemon -f -o /var/log/gdnc.log $GS/gdnc --auto --daemon
	i=0; while [ $i -lt 60 ] && ! pgrep -x gdnc >/dev/null; do sleep 1; i=$((i+1)); done
	rm -f $WS_SOCKET
	daemon -f -o /var/log/WindowServer.log -p /var/run/WindowServer.pid $WS -b kms -c /dev/ttyv0 -t -F
	sleep 2
	# the session: the login window (before the first unlock) asks which account and its password; the programs of the desktop run as that account from launchd (the launch agents: Dock, SystemUIServer, Finder, as on the Mac),
	# which also starts them again if they stop. Log Out ends the session and the login window comes back; Lock Screen (the top bar) puts the login window over the running session ("after the first unlock").
	# A test run (the hypervisor's product name is wsbsd-ci, set by the CI boot tests), or an image without the login window, signs the first account in by itself.
	( while true; do
		U=""; LW=/System/Library/CoreServices/loginwindow.app/Contents/MacOS/loginwindow
		if [ "$(kenv -q smbios.system.product 2>/dev/null)" = wsbsd-ci ] || [ ! -x $LW ]; then U=alex; id alex >/dev/null 2>&1 || U=root
		else U=$(/usr/lib/dyld $LW 2>/dev/null | tail -1); fi
		[ -n "$U" ] && id "$U" >/dev/null 2>&1 || { sleep 2; continue; }
		H=/Users/$U; [ "$U" = root ] && H=/Users/root
		mount | grep -q " $H " || mount -t tmpfs -o mode=755 tmpfs $H
		if [ ! -d $H/Desktop ]; then [ -d "/Library/User Template" ] && cp -R "/Library/User Template/." $H/ 2>/dev/null; mkdir -p $H/Desktop $H/Documents $H/Downloads $H/Library/Preferences $H/Movies $H/Music $H/Pictures $H/Public $H/GNUstep; chown -R $U $H 2>/dev/null; fi
		chmod 666 $WS_SOCKET 2>/dev/null
		echo $U > /var/run/wsbsd.user
		export HOME=$H USER=$U LOGNAME=$U
		if [ -x /usr/libexec/launchd ] && ls /System/Library/LaunchAgents/*.plist >/dev/null 2>&1; then
			daemon -u $U -o /var/log/launchd.log -p /var/run/launchd.pid env HOME=$H USER=$U LOGNAME=$U /usr/libexec/launchd /System/Library/LaunchAgents
		else
			for app in /System/Library/CoreServices/Dock.app/Contents/MacOS/Dock /System/Library/CoreServices/SystemUIServer.app/Contents/MacOS/SystemUIServer /System/Library/CoreServices/Finder.app/Contents/MacOS/Finder /System/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal; do
				[ -x $app ] && daemon -u $U -f -o /var/log/$(basename $app).log env HOME=$H USER=$U LOGNAME=$U /usr/lib/dyld $app
			done
		fi
		# the session lasts until launchd ends (Log Out kills it and everything the account runs)
		sleep 5; while [ -f /var/run/launchd.pid ] && kill -0 "$(cat /var/run/launchd.pid)" 2>/dev/null; do sleep 2; done
		pkill -KILL -u $U 2>/dev/null; sleep 1
	done ) >/var/log/session.log 2>&1 &
	# a report on the serial port (if there is one), 25 s after the start: the programs of the desktop that run, and the end of the log of the Finder and of every program that does not (the screen is the window server's and the console is muted)
	( sleep 25; { echo "== desktop report"; echo "== session.log"; tail -15 /var/log/session.log 2>/dev/null; echo "== Dock by hand"; U=$(cat /var/run/wsbsd.user 2>/dev/null); su -m "${U:-root}" -c "env HOME=/Users/${U:-root} timeout 6 /usr/lib/dyld /System/Library/CoreServices/Dock.app/Contents/MacOS/Dock" 2>&1 | tail -15; echo "== launchd.log"; tail -15 /var/log/launchd.log 2>/dev/null; ps ax -o pid,stat,command | grep -E "launchd|loginwindow" | grep -v grep; ps ax -o pid,stat,command | grep -E "WindowServer|Dock|SystemUIServer|Finder|Terminal|usernoted|gdnc|gdomap" | grep -v grep; for a in Finder WindowServer Dock SystemUIServer Terminal; do pgrep -f "$a" >/dev/null 2>&1 || echo "== $a is not running"; echo "== tail of $a.log"; tail -12 /var/log/$a.log 2>/dev/null; done; ls /System/Library/Desktop\ Pictures 2>&1; } > /dev/ttyu0 2>/dev/null ) &
}
macdesktop_stop()
{
	# the applications first, then the window server (it clears the screen and gives the console back), then the console messages are shown again
	[ -f /var/run/launchd.pid ] && kill "$(cat /var/run/launchd.pid)" 2>/dev/null; sleep 1
	for p in Terminal Finder Dock SystemUIServer; do pkill -x "$p" 2>/dev/null; done
	[ -f /var/run/WindowServer.pid ] && kill "$(cat /var/run/WindowServer.pid)" 2>/dev/null
	i=0; while [ $i -lt 30 ] && pgrep -f "WindowServer -b" >/dev/null 2>&1; do sleep 0.1; i=$((i+1)); done
	conscontrol mute off >/dev/null 2>&1
}
load_rc_config $name
run_rc_command "$1"
