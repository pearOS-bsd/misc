#!/bin/sh
# PROVIDE: macdesktop
# REQUIRE: LOGIN devd
# KEYWORD: shutdown
# The desktop: the window server on the console framebuffer, then the login-less session (Terminal). Silent: kernel messages are muted so that nothing is drawn over the screen.
. /etc/rc.subr
name="macdesktop"
rcvar="macdesktop_enable"
start_cmd="macdesktop_start"
stop_cmd="macdesktop_stop"
WS=/System/Library/PrivateFrameworks/SkyLight.framework/Versions/A/Resources/WindowServer
macdesktop_start()
{
	conscontrol mute on >/dev/null 2>&1
	export WS_SOCKET=/var/run/WindowServer.sock HOME=/Users/root XDG_CURRENT_DESKTOP=Aqua XDG_SESSION_DESKTOP=Aqua XDG_SESSION_TYPE=wsd TERM=xterm-256color
	[ -x /bin/zsh ] && export SHELL=/bin/zsh
	mkdir -p /var/run
	# the image is read-only: the home of the session (preferences, GNUstep's caches and sockets) is memory
	mount | grep -q ' /Users/Shared ' || mount -t tmpfs -o mode=1777 tmpfs /Users/Shared
	mount | grep -q ' /root ' || mount -t tmpfs -o mode=755 tmpfs /root
	# the home of the session is where macOS keeps it: /Users/<name> (a memory file system over the empty directory of the image) with the folders of a new account
	mount | grep -q ' /Users/root ' || mount -t tmpfs -o mode=755 tmpfs /Users/root
	mkdir -p /Users/root/Desktop /Users/root/Documents /Users/root/Downloads /Users/root/Library/Preferences /Users/root/Movies /Users/root/Music /Users/root/Pictures /Users/root/Public /Users/root/GNUstep
	mkdir -p /Users/Shared/GNUstep /root/GNUstep /Users/Shared/Downloads /root/Downloads /tmp/GNUstepSecure
	chmod 700 /tmp/GNUstepSecure
	# GNUstep's name server and notification center must be up before the first application: started on demand they time out on slow machines and the application dies ("unable to contact GDNC server")
	GS=/usr/local/GNUstep/System/Tools
	pgrep -x gdomap >/dev/null || daemon -f -p /var/run/gdomap.pid $GS/gdomap -f
	i=0; while [ $i -lt 30 ] && ! pgrep -x gdomap >/dev/null; do sleep 1; i=$((i+1)); done
	pgrep -x gdnc >/dev/null || daemon -f -o /var/log/gdnc.log $GS/gdnc --auto --daemon
	i=0; while [ $i -lt 60 ] && ! pgrep -x gdnc >/dev/null; do sleep 1; i=$((i+1)); done
	rm -f $WS_SOCKET
	daemon -f -o /var/log/WindowServer.log -p /var/run/WindowServer.pid $WS -b kms -c /dev/ttyv0 -t -F
	sleep 2
	# the programs of the desktop are started by launchd from the launch agents (/System/Library/LaunchAgents: Dock, SystemUIServer, Finder, as on the Mac), which also starts them again if they stop; without launchd (an image built without it) they are started one by one
	if [ -x /usr/libexec/launchd ] && ls /System/Library/LaunchAgents/*.plist >/dev/null 2>&1; then
		daemon -f -o /var/log/launchd.log -p /var/run/launchd.pid /usr/libexec/launchd /System/Library/LaunchAgents
	else
		for app in /System/Library/CoreServices/Dock.app/Contents/MacOS/Dock /System/Library/CoreServices/SystemUIServer.app/Contents/MacOS/SystemUIServer /System/Library/CoreServices/Finder.app/Contents/MacOS/Finder /System/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal; do
			daemon -f -o /var/log/$(basename $app).log /usr/lib/dyld $app
		done
	fi
	# a report on the serial port (if there is one), 25 s after the start: the programs of the desktop that run, and the end of the log of the Finder and of every program that does not (the screen is the window server's and the console is muted)
	( sleep 25; { echo "== desktop report"; ps ax -o pid,stat,command | grep -E "WindowServer|Dock|SystemUIServer|Finder|Terminal|usernoted|gdnc|gdomap" | grep -v grep; for a in Finder WindowServer Dock SystemUIServer Terminal; do pgrep -f "$a" >/dev/null 2>&1 || echo "== $a is not running"; echo "== tail of $a.log"; tail -12 /var/log/$a.log 2>/dev/null; done; ls /System/Library/Desktop\ Pictures 2>&1; } > /dev/ttyu0 2>/dev/null ) &
}
macdesktop_stop()
{
	# the applications first, then the window server (it clears the screen and gives the console back), then the console messages are shown again
	[ -f /var/run/launchd.pid ] && kill "$(cat /var/run/launchd.pid)" 2>/dev/null; sleep 1
	for p in Terminal Finder Dock SystemUIServer; do pkill -x "$p" 2>/dev/null; done
	[ -f /var/run/WindowServer.pid ] && kill "$(cat /var/run/WindowServer.pid)" 2>/dev/null
	i=0; while [ $i -lt 30 ] && pgrep -f "WindowServer -b" >/dev/null 2>&1; do sleep 0.1; i=$((i+1)); done
	conscontrol mute off >/dev/null 2>&1
}
load_rc_config $name
run_rc_command "$1"
