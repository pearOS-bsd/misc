#!/bin/sh
# build shim for TextMate: xcrun --sdk macosx TOOL args -> TOOL with the wsbsd SDK flags (clang), ibtool -> copy the xib, codesign -> no-op.
# Link steps lose the linker flags of Apple's ld (-dead_strip, -cache_path_lto, -framework X) and gain the libraries of this stack.
[ "$1" = "--sdk" ] && shift 2
tool="$1"; shift
XF="-fmodule-map-file=/root/wsbsd/sdk/modules/module.modulemap -I/root/wsbsd/sdk/modules -I/root/cfwrap -I/root/wsbsd/quartzcore/include -I/root/wsbsd/sdk/include -include /root/wsbsd/sdk/include/wsbsd/prelude.h -w"
case "$tool" in
  clang|clang++)
	. /usr/local/GNUstep/System/Library/Makefiles/GNUstep.sh
	link=1; skip=0; n=$#; i=0
	while [ $i -lt $n ]; do
		a="$1"; shift; i=$((i + 1))
		if [ $skip = 1 ]; then skip=0; continue; fi
		case "$a" in
			-c|-E|-S|-fsyntax-only) link=0 ;;
			-framework|-cache_path_lto|-object_path_lto) skip=1; continue ;;
			-dead_strip|-dead_strip_dylibs|-Wl,-dead_strip|-Wl,-dead_strip_dylibs|-Wl,-cache_path_lto*|-Wl,-object_path_lto*|-mmacosx-version-min=*) continue ;;
		esac
		set -- "$@" "$a"
	done
	if [ $link = 1 ]; then
		exec "$tool" "$@" -L/root/compat -Wl,-rpath,/root/compat -lwsbsdcompat -lQuartzCore $(gnustep-config --gui-libs) -lopal -lgnustep-corebase -ldispatch -lz -lcrypto -lsqlite3 -lcurl -L/usr/local/lib
	fi
	exec "$tool" "$@" $XF $(gnustep-config --objc-flags) ;;
  codesign) exit 0 ;;
  ibtool) out=""; in=""; while [ $# -gt 0 ]; do case "$1" in --compile) out="$2"; shift 2;; --*) shift;; *) in="$1"; shift;; esac; done; cp "$in" "$out" ;;
  *) exec "$tool" "$@" ;;
esac
